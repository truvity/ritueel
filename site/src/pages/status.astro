---
// The project status page: what exists and how far each milestone has got.
//
// - The design facts (decision records by status, reference pages, lines of code) are counted
//   from the repository at build time, with src/lib-status.ts. They never change after the build.
// - The milestones and what each delivers are the rows of docs/roadmap.md, also read at build
//   time and published as /data/status.json.
// - The issues per milestone and the checks on `main` are the live parts. The build writes a
//   snapshot of them into this page (issues read over REST when the build has a token,
//   src/lib-github.ts); the Worker keeps current data in KV and answers /api/status/live/, and a
//   same-origin script (src/scripts/status-live.ts) swaps it in. Without JavaScript, or when the
//   Worker has nothing, the snapshot stays and a note says so. One renderer draws both
//   (src/lib-status-html.ts).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Aside, Badge } from '@astrojs/starlight/components';
import '../styles/status.css';
import { docsHref } from '../../lib/docs-links.mjs';
import { readGithub } from '../lib-github';
import { milestoneNameDrift, milestoneRows } from '../lib-milestones';
import { partHtml } from '../lib-status-html';
import { BUILT_AT, designFacts, designLine, roadmapMilestones } from '../lib-status';

const facts = await designFacts();
const roadmap = roadmapMilestones();
const github = await readGithub();
const rows = milestoneRows(roadmap, github);
for (const line of milestoneNameDrift(roadmap, github)) console.log(`status: roadmap and GitHub differ: ${line}`);

// The snapshot of the live parts: the same renderer the Worker uses for the live fragment.
const snapshot = { rows, mode: 'snapshot' as const, asOf: BUILT_AT, available: github.available };

const asOf = BUILT_AT.replace('T', ' ').replace(/:\d{2}Z$/, ' UTC');
const headings = [
  { depth: 2, slug: 'milestones', text: 'Milestones' },
  { depth: 2, slug: 'design', text: 'Design' },
  { depth: 2, slug: 'issues-by-milestone', text: 'Issues by milestone' },
  { depth: 2, slug: 'checks-on-main', text: 'Checks on main' },
  { depth: 2, slug: 'how-this-page-is-built', text: 'How this page is built' },
];
---

<StarlightPage
  frontmatter={{
    title: 'Project status',
    description:
      'How far ritueel has got: decision records and reference pages counted from the repository, and the issues closed in each milestone, live.',
    tableOfContents: false,
  }}
  headings={headings}
>
  <div class="ps" data-github={github.available ? 'available' : 'unavailable'} data-live="snapshot" data-live-src="/api/status/live/">
    <p class="ps-design"><strong>{designLine(facts)}</strong></p>
    <p>
      ritueel is in its <a href="/roadmap/">design phase</a>: there is no release yet. This page counts what exists, for each
      milestone of the roadmap. <a href="#how-this-page-is-built">How this page is built</a> is at the end.
    </p>
    <p class="ps-legend">
      <Badge text="repository" variant="note" /> counted from this repository at the build, as of {asOf}.{' '}
      <Badge text="live" variant="tip" /> the issues and the checks on <code>main</code>, read from GitHub by the site's Worker about
      every 15 minutes; each block says the time its data is as of. Without JavaScript the page shows the snapshot taken at the build.
    </p>

    <p class="ps-live-note" data-live-note hidden>
      The live data could not be read just now, so the issue figures below are the build-time snapshot as of {asOf}.
    </p>

    {
      !github.available && (
        <Aside type="caution" title="Issue figures not available in this build">
          <p>
            This build could not read the issues from GitHub ({github.reason}), so the snapshot shows "—" for the issue figures. The
            live block fills them in when the Worker has read them. The decision records, the reference pages and the milestones are
            counted from the repository and do not depend on it.
          </p>
        </Aside>
      )
    }

    <h2 id="milestones">Milestones</h2>
    <p>
      The milestones M0 to M7 of the <a href="/roadmap/">roadmap</a>, in the order they are built. The current milestone is the
      first one that still has open issues.
    </p>
    <div data-live-part="cards" set:html={partHtml('cards', snapshot)} />

    <h2 id="design">Design</h2>
    <p>
      <Badge text="repository" variant="note" />{' '}
      Counted from <a href="https://github.com/truvity/ritueel/tree/main/docs"><code>docs/</code></a> at the build. The{' '}
      <a href="https://github.com/truvity/ritueel/tree/main/docs/decisions">decision records</a> are counted with the status each one states, and <a href="/design/">the design in brief</a> says what they decide.
    </p>
    <div class="ps-wrap not-content" tabindex="0" role="region" aria-labelledby="design-caption">
      <table class="ps-table">
        <caption id="design-caption">What exists in the repository</caption>
        <thead>
          <tr>
            <th scope="col">Count</th>
            <th scope="col" class="ps-r">Now</th>
            <th scope="col">Of which</th>
          </tr>
        </thead>
        <tbody>
          <tr data-fact="records">
            <th scope="row">Decision records</th>
            <td class="ps-num">{facts.records}</td>
            <td>
              Accepted: <span class="ps-num">{facts.accepted}</span>
              {facts.amended > 0 && <>{' '}(<span class="ps-num">{facts.amended}</span> amended by a later record)</>}
              {'; '}Proposed: <span class="ps-num">{facts.proposed}</span>
              {facts.other.map((o) => <>{'; '}{o.status}: <span class="ps-num">{o.count}</span></>)}
            </td>
          </tr>
          <tr data-fact="reference">
            <th scope="row">Reference pages</th>
            <td class="ps-num">{facts.reference}</td>
            <td><a href={docsHref('/reference/')}>Formats, commands and the hand-off contract</a></td>
          </tr>
          <tr data-fact="code">
            <th scope="row">Code</th>
            <td class="ps-num">{facts.code}</td>
            <td>lines of Go; Go code has started in milestone M2 (the local page in <code>ui/</code> is TypeScript and is not counted)</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 id="issues-by-milestone">Issues by milestone</h2>
    <p>
      <Badge text="live" variant="tip" />{' '}
      The issues of the repository, grouped by their GitHub milestone. Pull requests and the
      dependency dashboard are not counted. Issues with no milestone are the ones the roadmap lists under "After the first version",
      and any not placed yet.
    </p>
    <div data-live-part="issues" set:html={partHtml('issues', snapshot)} />

    <h2 id="checks-on-main">Checks on main</h2>
    <p>
      <Badge text="live" variant="tip" />{' '}
      The latest run of each workflow on <code>main</code>.
    </p>
    <div data-live-part="checks" set:html={partHtml('checks', snapshot)} />

    <h2 id="how-this-page-is-built">How this page is built</h2>
    <p>
      The page is static, with one live part. The site's build writes it from three sources; a small script served from this site
      then swaps the live parts in. It loads nothing from another host, and the page's{' '}
      <a href={docsHref('/contributing/tools/#the-site')}>Content-Security-Policy</a> is unchanged.
    </p>
    <ul>
      <li>
        <strong>The milestones</strong> and what each delivers are the rows of the table in <a href="/roadmap/">the roadmap</a>{' '}
        (<code>docs/roadmap.md</code>). A roadmap with no milestone row fails the build. The build also publishes them as{' '}
        <a href="/data/status.json"><code>/data/status.json</code></a>, which the Worker joins with the issues.
      </li>
      <li>
        <strong>The design figures</strong> are counted from the repository: decision records are <code>docs/decisions/NNNN-*.md</code>{' '}
        without the template, each with the status its own <code>Status</code> line states; reference pages are{' '}
        <code>docs/reference/*.md</code> without the index; code is the lines of every Go file outside <code>site/</code>. They change only when the site is built again.
      </li>
      <li>
        <strong>The issues and the checks</strong> are read from GitHub by the site's Worker, as a read-only GitHub App, about every
        15 minutes: the issues and milestones over the REST API, and the latest run of each workflow on <code>main</code>. The Worker
        keeps one document in storage and writes it only when something changed. The page's script fetches the Worker's answer
        (<a href="https://ritueel.id/api/status"><code>/api/status</code></a> is the same data as JSON) and swaps it in, milestone by milestone, keeping
        open the details you opened. Issues are grouped by their GitHub milestone, matched to the roadmap by its number, M0 to M7.
        Pull requests and bot issues are left out.
      </li>
    </ul>
    <p>
      <strong>Without JavaScript, or when the Worker has nothing,</strong> the page shows the snapshot the build took of the issues
      (as of {asOf}), and a note above it says so. A build with no GitHub token shows "—" in its place. The live data is as old as
      its last refresh, and each block says when that was. The repository's <a href={docsHref('/contributing/tools/#the-site')}>tools page</a>{' '}
      says how the site is built and deployed.
    </p>
  </div>
</StarlightPage>

<script>
  import '../scripts/status-live.ts';
</script>
