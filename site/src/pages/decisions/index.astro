---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { decisionFacts, listDecisions } from '../../lib-decisions';

// The status and date come from each record's own header lines, so the index always says
// what the record says. The template (0000) is not a record.
const records = (await listDecisions()).map(decisionFacts);
---

<StarlightPage
  frontmatter={{
    title: 'Decisions',
    description:
      'The archive of the architecture decision records for ritueel: what was decided, why, and which options were set aside. Built from docs/decisions.',
  }}
>
  <p>
    This is the archive of the architecture decision records (ADRs) of ritueel: what was decided, why, and which options were set
    aside. The records live in{' '}
    <a href="https://github.com/truvity/ritueel/tree/main/docs/decisions"><code>docs/decisions/</code></a>{' '}
    in the repository; this index is built from that directory on every build, and each status is the one the record states.
  </p>
  <p>
    A record links to the specifications and the research it was written with. This site does not publish those pages; such a
    link opens the file in the repository on GitHub. The one specification published here is the{' '}
    <a href="/reference/hand-off-contract/">hand-off contract</a>, because another project reads it at that address.
  </p>
  {
    records.length === 0 ? (
      <p>
        <em>No decision records have been published yet.</em>
      </p>
    ) : (
      <table>
        <thead>
          <tr>
            <th scope="col">Record</th>
            <th scope="col">Decision</th>
            <th scope="col">Status</th>
            <th scope="col">Date</th>
          </tr>
        </thead>
        <tbody>
          {records.map((r) => (
            <tr data-record={r.id}>
              <td>{r.number}</td>
              <td>
                <a href={`/decisions/${r.id}/`}>{r.title}</a>
              </td>
              <td>{r.status}</td>
              <td class="date">{r.date ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
</StarlightPage>

<style>
  /* A date such as 2026-11-11 stays on one line; the hyphens would let it break. */
  td.date {
    white-space: nowrap;
  }
</style>
