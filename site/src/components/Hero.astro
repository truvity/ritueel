---
// Starlight's Hero, replaced for the home page (the only page with `hero:` front matter): a short
// title and one line, so the reader's pains (the clouds in the page body) are on the first screen.
// Title and line come from the front matter of docs/index.mdx. The call-to-action links follow
// the answers, further down the page (home/Actions.astro). Upgrade note: the default component
// also renders a hero image, actions and a draft notice; the home page uses none of them.
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline } = data.hero || {};
---

<div class="home-hero">
  <h1 id="_top" data-page-title set:html={title} />
  {tagline && <p class="lede" set:html={tagline} />}
</div>

<style>
  .home-hero {
    max-width: 52rem;
    padding: 0;
  }
  h1 {
    margin: 0;
    font-family: var(--rt-serif);
    font-size: clamp(1.9rem, 1.4rem + 2vw, 2.7rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .lede {
    margin: 0.5rem 0 0;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.15rem);
    line-height: 1.45;
    color: var(--sl-color-text);
    text-wrap: pretty;
  }
</style>
