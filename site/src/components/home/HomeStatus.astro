---
// The status line under the mission: what exists, counted from the repository at build time, so
// it cannot drift. The counting is src/lib-status.ts, which the project status page (/status/)
// also uses, so the two always agree: decision records are docs/decisions/NNNN-*.md without the
// template, reference pages are docs/reference/*.md without the index, and code is the lines of
// every Go file outside site/ and node_modules (the product is Go; the scripts under tools/ are
// repository checks and are not counted). Zero Go files is zero lines, and the line says so.
import { designFacts, designLine } from '../../lib-status';

const line = designLine(await designFacts());
const built = new Date().toISOString().slice(0, 10);
---

<p class="not-content status-line">
  <strong>{line}</strong>{' '}
  <span>Counted at build, {built}.</span>{' '}
  <a href="/status/">Project status</a>
</p>

<style>
  .status-line {
    margin: 1rem 0 0;
    padding: 0.5rem 0.9rem;
    border-inline-start: 4px solid var(--rt-ink);
    background: color-mix(in srgb, var(--rt-ink) 7%, var(--sl-color-bg));
    color: var(--sl-color-text);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .status-line strong { color: var(--sl-color-white); }
  .status-line span { color: var(--sl-color-gray-2); white-space: nowrap; }
</style>
