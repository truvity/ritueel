---
// The call-to-action links, after the two answers. Same look as the former hero buttons.
interface Props {
  actions: { text: string; href: string; variant?: 'primary' | 'secondary' | 'minimal' }[];
}
const { actions } = Astro.props;
---

<p class="not-content actions">
  {actions.map((a) => <a href={a.href} class:list={['btn', a.variant ?? 'primary']}>{a.text}</a>)}
</p>

<style>
  .actions {
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 0.9rem;
  }
  .btn {
    display: inline-block;
    padding: 0.65rem 1.25rem;
    border: 2px solid var(--rt-ink);
    border-radius: 0.3rem;
    font-weight: 650;
    line-height: 1.2;
    text-decoration: none;
    color: var(--sl-color-white);
  }
  .btn.primary {
    background: var(--rt-ink);
    color: var(--rt-ink-on);
  }
  .btn.primary:hover { background: color-mix(in srgb, var(--rt-ink) 85%, var(--sl-color-white)); }
  .btn.secondary:hover { background: color-mix(in srgb, var(--rt-ink) 14%, transparent); }
  .btn.minimal {
    border-color: transparent;
    padding-inline: 0.4rem;
    text-decoration: underline;
    text-decoration-color: var(--rt-ink);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .btn:focus-visible {
    outline: 3px solid var(--sl-color-text-accent);
    outline-offset: 3px;
  }
</style>
