---
// The call-to-action links of the start page, after the heading: Starlight's own LinkButton, one for
// each action, as its Hero draws the buttons of a page that lists them in its front matter.
import { LinkButton } from '@astrojs/starlight/components';
interface Props {
  actions: { text: string; href: string; variant?: 'primary' | 'secondary' | 'minimal' }[];
}
const { actions } = Astro.props;
---

<p class="not-content actions">
  {actions.map((a) => <LinkButton href={a.href} variant={a.variant ?? 'primary'}>{a.text}</LinkButton>)}
</p>

<style>
  /* Inline, so that the links of Destinations.astro follow on the same line and wrap with it. */
  .actions {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 1.5rem 0.5rem 0;
    vertical-align: top;
  }
  .actions :global(.sl-link-button) {
    margin: 0;
  }
</style>
