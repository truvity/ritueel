---
// What ritueel answers to one cloud. A short green connector leads from the cloud above into the
// card, so the eye reads pain, then answer. The body is Markdown from the page.
interface Props {
  title: string;
  /** What is built, said plainly (the pages must say what exists). */
  status?: string;
}
const { title, status } = Astro.props;
---

<section class="not-content answer">
  <svg class="link" viewBox="0 0 24 40" aria-hidden="true" focusable="false">
    <path d="M12 1v34M5 28l7 8 7-8" />
  </svg>
  <div class="card">
    <h3>{title}</h3>
    <div class="body"><slot /></div>
    {status && <p class="status">{status}</p>}
  </div>
</section>

<style>
  .answer {
    position: relative;
    margin: 0;
    padding-left: 2.4rem;
  }
  .link {
    position: absolute;
    left: 0;
    top: -1.2rem;
    width: 1.4rem;
    height: 100%;
    max-height: 4.4rem;
    fill: none;
    stroke: var(--rt-ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }
  .card {
    height: 100%;
    box-sizing: border-box;
    padding: 1.25rem 1.4rem 1.3rem;
    border: 1px solid color-mix(in srgb, var(--rt-ink) 38%, var(--sl-color-bg));
    border-top: 4px solid var(--rt-ink);
    border-radius: 0.2rem 0.2rem 0.6rem 0.6rem;
    background: color-mix(in srgb, var(--rt-ink) 7%, var(--sl-color-bg));
  }
  h3 {
    margin: 0 0 0.6rem;
    font-family: var(--rt-serif);
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--sl-color-white);
  }
  .body :global(p) {
    margin: 0 0 0.9rem;
    line-height: 1.55;
    color: var(--sl-color-text);
  }
  .body :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .body :global(li) {
    margin: 0;
    padding: 0;
  }
  .body :global(li a) {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--rt-ink) 55%, var(--sl-color-bg));
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .body :global(li a:hover) {
    background: var(--rt-ink);
    border-color: var(--rt-ink);
    color: var(--rt-ink-on);
  }
  .body :global(li a:focus-visible) {
    outline: 3px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .body :global(a:not(li a)) {
    color: var(--sl-color-white);
    text-decoration-color: var(--rt-ink);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }
  .status {
    margin: 0.9rem 0 0;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--sl-color-gray-2);
  }
  @media (max-width: 40rem) {
    .answer { padding-left: 1.7rem; }
    .link { width: 1.1rem; }
    .card { padding: 1rem 1rem 1.1rem; }
  }
</style>
