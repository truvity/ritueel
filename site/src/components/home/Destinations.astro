---
// The places of the site menu, as a row of links under the buttons (How it works and the demo have
// their buttons, so they are not in the row). The start page has no sidebar (template: splash), and
// so no menu button on a phone; this row is its menu, and Glossary and The design are reached from
// the start page only through it. Keep it in step with `sidebar` in astro.config.mjs.
import { LinkButton } from '@astrojs/starlight/components';
interface Props {
  links: { text: string; href: string }[];
}
const { links } = Astro.props;
---

<nav class="not-content destinations" aria-label="Sections of the site">
  <ul>
    {links.map((l) => <li><LinkButton href={l.href} variant="secondary">{l.text}</LinkButton></li>)}
  </ul>
</nav>

<style>
  .destinations {
    display: inline-block;
    margin: 0 0 0.5rem;
    vertical-align: top;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    margin: 0;
    padding: 0;
  }
  .destinations :global(.sl-link-button) {
    margin: 0;
  }
</style>
