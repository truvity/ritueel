---
// The mission statement, set large. The text lives in docs/index.mdx and in ADR 0007; this only
// gives it room.
---

<figure class="not-content mission">
  <blockquote><slot /></blockquote>
  <figcaption>Accepted in <a href="/decisions/0007-ritueel-teaches-and-its-tools-simplify-the-ceremonies/">decision record 0007</a>.</figcaption>
</figure>

<style>
  .mission {
    margin: 0;
    padding: 0.2rem 0 0.2rem 1.4rem;
    border-inline-start: 5px solid var(--rt-ink);
  }
  blockquote {
    margin: 0;
    padding: 0;
    border: 0;
    font-family: var(--rt-serif);
    font-size: clamp(1.25rem, 1rem + 1.1vw, 1.75rem);
    line-height: 1.4;
    color: var(--sl-color-white);
    max-width: 44ch;
  }
  blockquote :global(p) { margin: 0; }
  figcaption {
    margin-top: 0.9rem;
    font-size: 0.88rem;
    color: var(--sl-color-gray-2);
  }
  figcaption a {
    color: inherit;
    text-decoration-color: var(--rt-ink);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }
  a:focus-visible {
    outline: 3px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
</style>
